{
  "name": "stlcpp",
  "displayName": "STLC++",
  "description": "Tree-sitter based syntax highlighting for the STLC++ language",
  "version": "0.1.1",
  "publisher": "aalto-opencs",
  "icon": "media/opencs-icon.png",
  "galleryBanner": {
    "color": "#0B0B0C",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aalto-opencs/vscode-stlcpp"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:stlcpp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "stlcpp",
        "aliases": [
          "STLC++",
          "stlcpp"
        ],
        "extensions": [
          ".stlc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "boolean",
        "description": "Boolean literals"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "stlcpp",
        "scopes": {
          "boolean": [
            "constant.language.boolean"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run test:release && npm run test:dependencies && npm run test:extension",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:dependencies": "node --test tests/dependencies/*.test.cjs"
  },
  "config": {
    "vscodeTestVersion": "1.130.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.4.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.3"
  }
}
